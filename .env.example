# ── EDXSO · School Influence Discovery ─────────────────────────────────────
# Copy to .env for local use. All values below are safe local defaults —
# there are no real secrets in this file.

APP_ENV=development

# PostgreSQL (docker-compose.yml starts a matching instance)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Dataset / ranker identifiers (recorded on every discovery run)
DATASET_VERSION=india-school-ecosystem-v1
RANKER_VERSION=hybrid-v1
DEFAULT_RESULT_LIMIT=30
MAX_RESULT_LIMIT=100

# Embeddings: this build uses a deterministic local hashed-concept embedder
# (edxso-hash-concept-embed@v1.0.0, 512-d) — no download, fully reproducible.
# The fields below document the interface for a future Sentence-Transformers swap.
EMBEDDING_MODEL=edxso-hash-concept-embed
EMBEDDING_MODEL_REVISION=v1.0.0

# Optional LLM adapter (OFF in this build). Ranking never depends on it: a failed
# or absent LLM falls back to deterministic evidence-quoting templates.
LLM_PROVIDER=none
LLM_API_KEY=

# Optional: when set, POST /api/v1/settings requires header "x-admin-token: <value>".
# Leave empty for the open demo mode.
ADMIN_TOKEN=

# Public base URL (used only by docs / external clients)
NEXT_PUBLIC_APP_URL=http://localhost:3000
